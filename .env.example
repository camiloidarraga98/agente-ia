# Optional: without a key, the workspace uses explicitly labeled demo results.
# Enter the value securely in environment settings; never commit a real key.
JAC_OPENAI_API_KEY=
JAC_MODEL=gpt-4.1-mini
PORT=3001
JAC_DATA_DIR=.data
# Required in production: at least 16 characters. Configure securely in hosting.
# Leave unset for local development without login.
JAC_ACCESS_PASSWORD=
# Optional: API key used only by your GPT's actions (32+ characters).
# Different from the office password; configure securely, never in the browser.
JAC_GPT_ACTIONS_KEY=
# On Render, RENDER_EXTERNAL_URL supplies this automatically.
PUBLIC_ORIGIN=
